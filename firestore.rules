rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // clubs collection: public read/write so demo portal can save without
    // requiring a specific Firebase Auth user to exist in the console.
    // tc-home also reads this without auth.
    match /clubs/{clubId} {
      allow read, write: if true;
    }
    match /clubs/{clubId}/{collection}/{docId} {
      allow read, write: if true;
    }
    // All other documents require auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
