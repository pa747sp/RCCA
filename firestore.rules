rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // clubs collection: public read so tc-home can display the club directory
    // without requiring Firebase Auth (tc-home is a public marketing site)
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /clubs/{clubId}/{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // All other documents require auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
